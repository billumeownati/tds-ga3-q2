# Public base URL you will submit, including the API path if you use one.
# For local development:
A2A_BASE_URL=http://127.0.0.1:8000/

# Local Ollama example. Public hosting should use an accessible hosted provider.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3:4b
LLM_TIMEOUT_SECONDS=35

# Local-only default. Set DATABASE_URL to a durable PostgreSQL URL in production.
DATABASE_URL=sqlite:///./invoice_agent.db
